NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/dischargecare
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_ISSUER=dischargecare-api
JWT_AUDIENCE=dischargecare-client
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
UPLOAD_DIR=./storage
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=1
ENABLE_WEBP_UPLOADS=true
OCR_PROVIDER=none
OCR_LANGUAGES=eng+hin
PROCESSING_TIMEOUT_MS=120000
MIN_READABLE_TEXT_CHARS=40
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MAX=10
DEFAULT_LANGUAGE=en
DEFAULT_REMINDER_TIME=06:00
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/dischargecare_test
