NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/dischargecare
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_ISSUER=dischargecare-api
JWT_AUDIENCE=dischargecare-client
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_RETRY_DELAY_MS=1000
AI_MAX_INPUT_CHARS=120000
AI_MAX_PAGES=40
ALLOW_TEST_EXTRACTION_FIXTURE=false
ALLOW_TEST_CHAT_FIXTURE=false
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_MAX_RETRIEVAL_CHARS=12000
CHAT_MAX_PASSAGES=8
CHAT_MAX_HISTORY_MESSAGES=200
CHAT_RATE_LIMIT_MAX=30
EMERGENCY_CONTACT_NUMBER=
UPLOAD_DIR=./storage
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=1
ENABLE_WEBP_UPLOADS=true
OCR_PROVIDER=none
OCR_LANGUAGES=eng+hin
PROCESSING_TIMEOUT_MS=120000
MIN_READABLE_TEXT_CHARS=40
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
AUTH_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_MAX=10
EXTRACTION_RATE_LIMIT_MAX=10
NODE_ENV=development
DEFAULT_LANGUAGE=en
DEFAULT_REMINDER_TIME=06:00
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/dischargecare_test
