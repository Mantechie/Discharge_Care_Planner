# true = all data in browser memory only (default). false = use Express + MongoDB backend.
# VITE_USE_LOCAL_DATA=true

# Read aloud: browser (default) or rapidapi via server proxy (requires VITE_USE_LOCAL_DATA=false + RAPIDAPI_KEY on server)
# VITE_TTS_PROVIDER=rapidapi

# Optional absolute API origin when VITE_USE_LOCAL_DATA=false. Leave empty for Vite proxy /api.
# VITE_API_BASE_URL=http://localhost:5000

# Must match server MAX_FILE_SIZE_MB (default 10).
# VITE_MAX_FILE_SIZE_MB=10

# Match server ENABLE_WEBP_UPLOADS (default true).
# VITE_ENABLE_WEBP_UPLOADS=true
